# 复制为 .env 后按需修改。生产环境务必覆盖 JWT_SECRET 和数据库密码。

APP_ENV=dev
DEBUG=true

# 数据库
POSTGRES_USER=a03
POSTGRES_PASSWORD=a03pass
POSTGRES_DB=a03_contract
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# 本地单进程开发可为 false；Compose/生产必须为 true。
AUDIT_ASYNC=false

# 安全（生产必改）
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 文件存储
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# 合同类型自动就绪默认关闭；未校准前需人工确认。
CONTRACT_TYPE_AUTO_READY_ENABLED=false
# 合同草稿进入回收站后的保留天数
CONTRACT_TRASH_RETENTION_DAYS=30

# 离线 OCR 资源与质量门槛
OCR_MAX_PAGES=100
OCR_MAX_PAGE_PIXELS=16000000
OCR_DPI=180
OCR_TIMEOUT_SECONDS=120
OCR_MIN_CONFIDENCE=0.75

# 合同文件加密存储（企业数据安全硬约束）
# 留空则不加密（本地开发/演示快速启动）；生产部署必须设置。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPT_KEY=

# LLM Adapter（当前项目测试基线；调用公网 API 前需确认合同数据合规要求）
# 方案 A：DeepSeek 中转 API
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://yorhamc.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=3200
LLM_TIMEOUT=120
AUDIT_DEADLINE_SECONDS=1500

# 方案 B：私有化 Qwen（生产/交付推荐，合同数据不出公网）
# LLM_PROVIDER=qwen
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:14b
# LLM_MAX_OUTPUT_TOKENS=3200
# LLM_TIMEOUT=120

# Embedding 本地模型（RAG 向量化，合同数据不出企业）
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 强制离线：不联网校验/下载模型，直读本地缓存，避免 huggingface.co 不可达时卡超时。
# - Docker 部署：已在镜像构建阶段烤入模型并通过 Dockerfile 的 ENV 固化（见 backend/Dockerfile），无需在此配置。
# - 宿主机裸跑（非 Docker）：运行时始终只读本地缓存，不会隐式联网下载。
#   首次部署请由运维人员显式预下载（该命令需要联网，并应经过安全审计）：
#     python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-zh-v1.5')"
#   缓存完成后再启动 uvicorn；缓存缺失会快速失败并降级为 BM25。
