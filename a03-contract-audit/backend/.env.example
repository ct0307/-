# 复制为 .env 后按需修改。生产环境务必覆盖 JWT_SECRET 和数据库密码。

APP_ENV=dev
DEBUG=true

# 数据库
POSTGRES_USER=a03
POSTGRES_PASSWORD=a03pass
POSTGRES_DB=a03_contract
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# 本地单进程开发可为 false；Compose/生产必须为 true。
AUDIT_ASYNC=false

# 安全（生产必改）
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 文件存储
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_BATCH_FILES=200
MAX_BATCH_MB=500
# 单位为 MiB；增大单批总量时须同步全部代理的 client_max_body_size。
# 默认人工核验；deterministic 仅启用文档列明的有限规则，不是通用语义验证。
EVIDENCE_VALIDATION_MODE=manual_only
# 合同类型自动就绪默认关闭；未校准前需人工确认。
CONTRACT_TYPE_AUTO_READY_ENABLED=false
# 合同草稿进入回收站后的保留天数
CONTRACT_TRASH_RETENTION_DAYS=30

# 离线 OCR 资源与质量门槛
OCR_MAX_PAGES=100
OCR_MAX_PAGE_PIXELS=16000000
OCR_DPI=180
OCR_TIMEOUT_SECONDS=120
OCR_MIN_CONFIDENCE=0.75

# 合同文件加密存储（企业数据安全硬约束）
# 留空则不加密（本地开发/演示快速启动）；生产部署必须设置。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPT_KEY=

# LLM Adapter（未配置目的地时禁止外部调用）
# 方案 A：企业批准的外部 OpenAI 兼容 API
LLM_PROVIDER=deepseek
# external_model 仅允许明确授权的 HTTPS 地址；private_model 仅允许明确私网/回环 IP；rules_fallback 禁止模型调用。
MODEL_PROCESSING_MODE=external_model
LLM_BASE_URL=
# 企业确认服务商与数据处理范围后，显式填写同一 HTTPS 基地址。默认禁止外传。
MODEL_EXTERNAL_ALLOWED_BASE_URLS=[]
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=3200
LLM_TIMEOUT=120
AUDIT_DEADLINE_SECONDS=1500
AUDIT_BATCH_SECONDARY_ENABLED=false
AUDIT_BATCH_ENRICHMENT_ENABLED=false
AUDIT_MODEL_CONCURRENCY=2
AUDIT_MAX_MODEL_CALLS=120
AUDIT_MAX_TOKEN_BUDGET=3000000
AUDIT_DIRECTED_MAX_CALLS=3

# 方案 B：私有化 Qwen（生产/交付推荐，合同数据不出公网）
# LLM_PROVIDER=qwen
# MODEL_PROCESSING_MODE=private_model
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:14b
# LLM_MAX_OUTPUT_TOKENS=3200
# LLM_TIMEOUT=120

# Embedding 本地模型（RAG 向量化，合同数据不出企业）
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# bge 查询侧检索指令前缀（官方推荐，仅 local 后端生效；文档侧入库不加）。置空关闭。
# EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 强制离线：不联网校验/下载模型，直读本地缓存，避免 huggingface.co 不可达时卡超时。
# - Docker 部署：已在镜像构建阶段烤入模型并通过 Dockerfile 的 ENV 固化（见 backend/Dockerfile），无需在此配置。
# - 宿主机裸跑（非 Docker）：运行时始终只读本地缓存，不会隐式联网下载。
#   首次部署请由运维人员显式预下载（该命令需要联网，并应经过安全审计）：
#     python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-zh-v1.5')"
#   缓存完成后再启动 uvicorn；缓存缺失会快速失败并降级为 BM25。

# Cross-Encoder 精排默认关闭。local 模式只读取本地 Hugging Face 缓存，不隐式联网。
RERANK_BACKEND=disabled
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_K=30
# 启用前必须单独取得用户确认，并完成：模型来源与许可证、文件体积、逐文件 SHA-256、
# 供应链风险、离线缓存目录和合同文本不离开本机的审计。此示例配置不会下载模型。
