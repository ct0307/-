{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A03 合同要素人工金标准",
  "type": "object",
  "required": ["case_id", "file", "contract_type", "document_kind", "gold", "reviewers", "review_status", "version"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "file": {"type": "string", "minLength": 1},
    "contract_type": {"type": "string", "minLength": 1},
    "document_kind": {"enum": ["pdf", "docx", "scanned_pdf"]},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_status": {"enum": ["agreed", "adjudicated"]},
    "adjudicator": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "gold": {
      "type": "object",
      "required": ["party_a", "party_b", "subject", "amount", "duration", "payment_terms"],
      "properties": {
        "party_a": {"type": ["string", "null"]},
        "party_b": {"type": ["string", "null"]},
        "subject": {"type": ["string", "null"]},
        "amount": {"type": ["string", "null"]},
        "duration": {"type": ["string", "null"]},
        "payment_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"review_status": {"const": "adjudicated"}},
        "required": ["review_status"]
      },
      "then": {"required": ["adjudicator"]}
    }
  ],
  "additionalProperties": false
}
